{% set include_remote_db = (REMOTE_DB_IP is defined and REMOTE_DB_PORT is defined) %}
{
    "INSTANCES": {
        "valkey":{
            "hostname" : "{{HOST_IP}}",
            "port" : {{VALKEY_PORT}},
            "unix_socket_path" : "/var/run/valkey{{DEV}}/valkey.sock",
            "persistence_for_warm_boot" : "yes"
            {% if DATABASE_TYPE is defined and DATABASE_TYPE != "" %}
            ,"database_type": "{{DATABASE_TYPE}}"
            {% endif %}
        },
        "valkey_chassis":{
            "hostname" : "valkey_chassis.server",
            "port": 6380,
            "unix_socket_path": "/var/run/valkey-chassis/valkey_chassis.sock",
            "persistence_for_warm_boot" : "yes"
        }
{% if include_remote_db %}
        ,"remote_valkey":{
            "hostname" : "{{REMOTE_DB_IP}}",
            "port" : {{REMOTE_DB_PORT}},
            "unix_socket_path": "",
            "persistence_for_warm_boot" : "yes"
        }
{% endif %}
{% if DATABASE_TYPE is defined and DATABASE_TYPE == "dpudb" %}
{% else %}
        ,
        "valkey_bmp":{
            "hostname" : "{{HOST_IP}}",
            "port" : {{BMP_DB_PORT}},
            "unix_socket_path" : "/var/run/valkey{{DEV}}/valkey_bmp.sock",
            "persistence_for_warm_boot" : "yes"
        }
{% endif %}
    },
    "DATABASES" : {
        "APPL_DB" : {
            "id" : 0,
            "separator": ":",
            "instance" : "valkey"
        },
        "ASIC_DB" : {
            "id" : 1,
            "separator": ":",
            "instance" : "valkey"
        },
        "COUNTERS_DB" : {
            "id" : 2,
            "separator": ":",
            "instance" : "valkey"
        },
        "LOGLEVEL_DB" : {
            "id" : 3,
            "separator": ":",
            "instance" : "valkey"
        },
        "CONFIG_DB" : {
            "id" : 4,
            "separator": "|",
            "instance" : "valkey"
        },
        "PFC_WD_DB" : {
            "id" : 5,
            "separator": ":",
            "instance" : "valkey"
        },
        "FLEX_COUNTER_DB" : {
            "id" : 5,
            "separator": ":",
            "instance" : "valkey"
        },
        "STATE_DB" : {
            "id" : 6,
            "separator": "|",
            "instance" : "valkey"
        },
        "SNMP_OVERLAY_DB" : {
            "id" : 7,
            "separator": "|",
            "instance" : "valkey"
        },
        "RESTAPI_DB" : {
            "id" : 8,
            "separator": "|",
            "instance" : "valkey"
        },
        "GB_ASIC_DB" : {
            "id" : 9,
            "separator": ":",
            "instance" : "valkey"
        },
        "GB_COUNTERS_DB" : {
            "id" : 10,
            "separator": ":",
            "instance" : "valkey"
        },
        "GB_FLEX_COUNTER_DB" : {
            "id" : 11,
            "separator": ":",
            "instance" : "valkey"
        },
        "CHASSIS_APP_DB" : {
            "id" : 12,
            "separator": "|",
            "instance" : "valkey_chassis"
        },
        "CHASSIS_STATE_DB" : {
            "id" : 13,
            "separator": "|",
            "instance" : "valkey_chassis"
        },
        "APPL_STATE_DB" : {
            "id" : 14,
            "separator": ":",
            "instance" : "valkey"
        }
{% if DATABASE_TYPE is defined and DATABASE_TYPE == "dpudb" %}
        ,
        "DPU_APPL_DB" : {
            "id" : 15,
            "separator": ":",
            "instance" : {% if include_remote_db %} "remote_valkey" {% else %} "valkey" {% endif %},
            "format": "proto"
        },
        "DPU_APPL_STATE_DB" : {
            "id" : 16,
            "separator": "|",
            "instance" : {% if include_remote_db %} "remote_valkey" {% else %} "valkey" {% endif %}
        },
        "DPU_STATE_DB" : {
            "id" : 17,
            "separator": "|",
            "instance" : {% if include_remote_db %} "remote_valkey" {% else %} "valkey" {% endif %}
        },
        "DPU_COUNTERS_DB" : {
            "id" : 18,
            "separator": ":",
            "instance" : {% if include_remote_db %} "remote_valkey" {% else %} "valkey" {% endif %}
        }
{% else %}
        ,
        "BMP_STATE_DB" : {
            "id" : 20,
            "separator": "|",
            "instance" : "valkey_bmp"
        }
{% endif %}
    },
    "VERSION" : "1.0"
}
